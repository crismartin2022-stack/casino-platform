:80 {
    # Servir archivos estáticos desde el directorio actual
    root * .
    # Para peticiones que no son archivos (rutas de módulos JS), servir el index.html
    @notAFile not file
    handle @notAFile {
        rewrite * /index.html
    }
    # Servir todos los demás archivos normalmente
    file_server
}
