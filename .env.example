# Copia a .env para desarrollo local (en Railway se ponen en Variables).

# Obligatoria en producción: token para entrar al panel /admin
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# IA de los agentes (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Opcional: modelo más potente solo para el Director
# ANTHROPIC_DIRECTOR_MODEL=claude-opus-5-5

# Imágenes (Venice)
VENICE_API_KEY=
VENICE_IMAGE_MODEL=qwen-image-2
VENICE_EDIT_MODEL=qwen-image-2-edit

# Sonido y música (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Datos: en Railway monta un Volume en /data (se detecta solo con RAILWAY_VOLUME_MOUNT_PATH)
# DATA_DIR=./data

# Opcionales
# PUBLIC_URL=https://tu-dominio.com
# DEMO_BALANCE_CENTS=100000
# SESSION_TTL_HOURS=12
# CORS_ORIGINS=https://casino-operador.com,https://otro.com
# PUBLISH_SIM_SPINS=500000
# PUBLISH_MAX_RTP_DEVIATION=0.01
